{"ocr_results":[{"text":"·李作鹏回憶绿·第八篇·中人的心聲·","box":[[15,42],[473,41],[473,62],[15,64]]},{"text":"八、鐵石心","box":[[255,167],[361,167],[361,189],[255,189]]},{"text":"1973年于通系","box":[[243,212],[376,212],[376,232],[243,232]]},{"text":"往昔烏紗千斤重，而今麗官高興？","box":[[141,252],[470,255],[470,278],[140,275]]},{"text":"逆境不青雲志，愈挫愈鐵石心。","box":[[141,283],[467,286],[467,308],[140,304]]},{"text":"九、言可畏（四首）","box":[[201,373],[405,376],[405,397],[200,394]]},{"text":"1973年于通系","box":[[239,416],[372,418],[371,440],[239,437]]},{"text":"（一）","box":[[278,461],[332,461],[332,483],[278,483]]},{"text":"武人不畏虎，獨怕言夫。","box":[[179,488],[421,493],[420,516],[179,511]]},{"text":"造蔑語，真相離清楚。","box":[[179,518],[421,524],[420,546],[178,539]]},{"text":"（二）","box":[[277,549],[333,549],[333,575],[277,575]]},{"text":"某受陷久，颇似園中韭。","box":[[180,577],[421,584],[420,605],[179,599]]},{"text":"日日被刀割，無中還生有。","box":[[181,606],[424,613],[423,636],[180,629]]},{"text":"（三）","box":[[276,638],[333,638],[333,663],[276,663]]},{"text":"言黑白，恶臭三寸舌。","box":[[181,665],[421,674],[420,695],[180,686]]},{"text":"舌上有毒物，毅人不見血。","box":[[181,694],[421,704],[420,725],[180,715]]},{"text":"（四）","box":[[279,726],[331,729],[330,751],[278,749]]},{"text":"螺未烧盏，忽被风息。","box":[[181,753],[421,762],[420,784],[180,774]]},{"text":"水清看底石，心潔见天理。","box":[[182,781],[421,792],[420,813],[181,802]]},{"text":"方块字读书社区","box":[[269,902],[415,902],[415,926],[269,926]]},{"text":"810","box":[[30,967],[65,967],[65,987],[30,987]]}],"dimensions":{"height":1000,"width":684}}