{"ocr_results":[{"text":"·李作鹏回憶绿·第八篇·狱中人的心聲","box":[[12,36],[469,32],[469,55],[12,60]]},{"text":"三、聲名裂","box":[[263,110],[370,110],[370,131],[263,131]]},{"text":"1971年冬于通縣","box":[[239,152],[394,152],[394,172],[239,172]]},{"text":"終生门紅變黑，將軍百载聲名裂。","box":[[146,193],[477,193],[477,216],[146,216]]},{"text":"别鳥懷情忽起，不啼清泪長啼血。","box":[[147,224],[476,225],[476,246],[147,245]]},{"text":"四、夜思（四首）","box":[[225,313],[396,316],[396,337],[225,335]]},{"text":"1972年于通縣","box":[[247,358],[380,360],[379,380],[246,378]]},{"text":"（一）","box":[[287,401],[339,401],[339,424],[287,424]]},{"text":"食物咽，轉無眠。","box":[[208,431],[408,435],[408,455],[208,452]]},{"text":"通宵苦思，泪枕一片。","box":[[208,461],[413,464],[413,487],[208,484]]},{"text":"（二）","box":[[286,493],[339,493],[339,515],[286,515]]},{"text":"國家大，成竹在胸。","box":[[208,521],[409,526],[409,548],[207,542]]},{"text":"牲一己，報酬萬衆。","box":[[206,549],[409,555],[409,579],[205,573]]},{"text":"（三）","box":[[285,580],[341,583],[340,608],[284,605]]},{"text":"陷攻撃，大放狗屁。","box":[[208,610],[408,615],[408,638],[207,633]]},{"text":"忍氣吞聲，眼望千里。","box":[[209,640],[409,647],[409,669],[208,661]]},{"text":"（四）","box":[[285,671],[341,671],[341,697],[285,697]]},{"text":"聚口毁響，石浮木沉。","box":[[210,699],[408,706],[408,727],[209,721]]},{"text":"非成是，孤掌離鸣。","box":[[210,729],[408,735],[408,756],[209,750]]},{"text":"五、指鹿爲馬","box":[[252,816],[379,821],[378,843],[251,838]]},{"text":"1972年于通系","box":[[251,858],[383,863],[382,884],[250,879]]},{"text":"微来不可方块字读书社区分明","box":[[150,891],[476,903],[475,933],[149,921]]},{"text":"指鹿嵌骗乃骏馬，胡八道無人信。","box":[[152,921],[476,933],[475,957],[151,945]]},{"text":"808","box":[[41,965],[77,968],[75,988],[39,985]]}],"dimensions":{"height":1000,"width":684}}