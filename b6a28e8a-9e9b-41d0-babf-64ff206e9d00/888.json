{"ocr_results":[{"text":"·李作鹏回憶绿·第八篇·狱中人的心聲","box":[[14,25],[472,20],[472,43],[14,48]]},{"text":"十七、白骨精亡","box":[[232,176],[405,176],[405,201],[232,201]]},{"text":"1976年10月于通縣","box":[[229,221],[408,221],[408,242],[229,242]]},{"text":"鲁無名江，流久不清。","box":[[117,265],[358,265],[358,285],[117,285]]},{"text":"無風黑浪三尺，有風帆舟沉。","box":[[118,296],[379,296],[379,317],[118,317]]},{"text":"礼水直画横撞，腾似牛鬼蛇神，疑是白骨精。","box":[[117,325],[533,326],[533,349],[117,348]]},{"text":"夜居约魚，日革文化命。","box":[[118,357],[359,357],[359,377],[118,377]]},{"text":"造反風，權雨，武门。","box":[[116,416],[356,418],[356,439],[116,436]]},{"text":"四妖横行國，雞犬不安寧。","box":[[118,446],[380,448],[380,469],[118,467]]},{"text":"天怒人恨除害，妖魔一網打盏，國歌舞度。","box":[[119,476],[532,480],[532,501],[119,497]]},{"text":"吕武笑江妖，黄袍成泡影。","box":[[119,504],[361,510],[360,531],[119,525]]},{"text":"十八、咏冬","box":[[254,596],[381,598],[380,622],[253,620]]},{"text":"1976年冬","box":[[271,636],[365,641],[364,665],[269,660]]},{"text":"漫天雪，房頂樹梢遍地白。","box":[[153,675],[395,684],[394,705],[152,696]]},{"text":"遍地白.消减害，苗壮樹叠。","box":[[153,705],[437,714],[436,735],[152,727]]},{"text":"寒翠古松柏，更喜梅花香飘烈。","box":[[154,734],[480,743],[479,766],[153,757]]},{"text":"香飘烈，送冬迎春，更季换節。","box":[[155,764],[438,773],[437,795],[154,785]]},{"text":"方块字读书社区","box":[[269,902],[415,902],[415,926],[269,926]]},{"text":"814","box":[[44,958],[82,958],[82,981],[44,981]]}],"dimensions":{"height":1000,"width":684}}