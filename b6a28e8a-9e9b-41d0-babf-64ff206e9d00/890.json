{"ocr_results":[{"text":"·李作鹏回愤绿·第八篇·狱中人的心聲","box":[[6,24],[473,22],[473,46],[6,48]]},{"text":"二十二、感（二首）","box":[[202,130],[429,128],[430,151],[203,153]]},{"text":"1978年于秦城中","box":[[228,174],[407,173],[407,195],[228,196]]},{"text":"（一)","box":[[291,218],[344,218],[344,240],[291,240]]},{"text":"渴饮蒋匪血，食倭寇肉。","box":[[187,251],[438,251],[438,271],[187,271]]},{"text":"恨不载场死，留作小人辱。","box":[[187,282],[438,282],[438,302],[187,302]]},{"text":"（二）","box":[[288,310],[345,310],[345,336],[288,336]]},{"text":"寧顾為民死，痛恨株连亡。","box":[[187,343],[438,345],[438,366],[187,364]]},{"text":"不清不白冤，實乃替罪羊。","box":[[187,374],[437,375],[437,396],[187,395]]},{"text":"二十三、懷念海軍","box":[[231,467],[404,467],[404,488],[231,488]]},{"text":"1978年春于秦城中","box":[[217,510],[415,513],[415,533],[217,530]]},{"text":"十载微薄奉獻，萬里海防踏遍","box":[[170,552],[460,558],[460,579],[170,573]]},{"text":"落人侵贼機，消减。","box":[[169,583],[458,589],[458,609],[169,603]]},{"text":"碼頭機場倍增，核艇導新添。","box":[[168,612],[458,619],[458,640],[168,633]]},{"text":"建設强大海軍，宜争早日實现。","box":[[169,642],[459,649],[459,671],[169,663]]},{"text":"二十四、丹心","box":[[250,732],[391,737],[390,760],[249,755]]},{"text":"1978年于秦城中","box":[[234,775],[408,780],[408,802],[233,796]]},{"text":"革命热情未稍减，老兵豪氣能残。","box":[[155,813],[482,824],[481,845],[154,834]]},{"text":"雪山草地皆横開，南征北载凯歌還。","box":[[155,844],[483,853],[482,874],[155,865]]},{"text":"汗馬失蹄遭侮辱，乌鸦得势狂翩。","box":[[156,872],[483,882],[482,903],[156,893]]},{"text":"粉身碎督仿块字读书社区可對天。","box":[[156,899],[481,906],[480,930],[156,922]]},{"text":"816","box":[[43,973],[79,973],[79,993],[43,993]]}],"dimensions":{"height":1000,"width":684}}