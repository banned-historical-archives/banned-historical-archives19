{"ocr_results":[{"text":"作者简簡介","box":[[393,114],[535,119],[534,151],[392,145]]},{"text":"李作鹏漢族，1914年4月生于江西","box":[[355,190],[598,198],[598,218],[355,210]]},{"text":"省吉安縣。","box":[[320,217],[396,221],[395,242],[319,239]]},{"text":"1930年参加中圆工晨红車，1931年","box":[[356,248],[599,254],[599,275],[356,269]]},{"text":"加入共產主義青年圆，1932年轉入中国","box":[[320,276],[597,283],[597,305],[320,297]]},{"text":"共産壹。1955年被授子中将军街。","box":[[320,304],[557,311],[557,332],[320,325]]},{"text":"红軍時期，是任红一方面軍總司令","box":[[356,336],[601,341],[601,361],[356,356]]},{"text":"部傳令兵、朱德警衛排衡士、单委報","box":[[320,364],[600,368],[600,388],[320,384]]},{"text":"科科员、軍委機要科科员。参加了二萬","box":[[319,393],[599,396],[599,417],[319,414]]},{"text":"五千里长征，時任中革軍委二局二科科","box":[[320,422],[598,424],[598,445],[320,442]]},{"text":"长。","box":[[320,452],[347,452],[347,473],[320,473]]},{"text":"抗日争時期，壁任八路軍第115师","box":[[355,481],[597,481],[597,501],[355,501]]},{"text":"值察科长、作靴科长和参課處處长。","box":[[320,510],[561,510],[561,530],[320,530]]},{"text":"解放靴争時期，歷任东北民主聊軍","box":[[356,539],[598,537],[598,557],[356,560]]},{"text":"前方總部参谋處长，第一到司令员","box":[[321,568],[598,565],[598,586],[321,588]]},{"text":"兼参谋长，第六副司令員兼第16师","box":[[320,597],[599,593],[599,614],[320,618]]},{"text":"師长，第四野靴军第43軍軍长。","box":[[319,626],[544,624],[544,644],[319,646]]},{"text":"建国之后，严任第15兵图参谋長，","box":[[356,655],[590,651],[590,671],[356,676]]},{"text":"第一高级步兵學校校长，總参谋却軍事训","box":[[321,684],[601,678],[601,699],[321,705]]},{"text":"练部部长，海軍常務副司令员，别總参谋","box":[[319,714],[601,706],[601,728],[319,735]]},{"text":"长兼海軍第一政委。","box":[[320,743],[454,739],[454,760],[320,764]]},{"text":"1969年，在中共堂的第九届代表大","box":[[357,770],[598,762],[598,783],[357,792]]},{"text":"會上，當遥為中央委员、中央政治局委","box":[[322,802],[597,791],[598,812],[323,823]]},{"text":"员。同時當遥为中央軍委委员，并被任","box":[[324,830],[598,818],[599,839],[325,851]]},{"text":"命為单委解事组成员。","box":[[320,859],[479,853],[480,873],[321,879]]},{"text":"2009年1月因病去世，终年95康","box":[[354,886],[572,876],[573,896],[355,907]]},{"text":"方块字读书社区","box":[[264,904],[409,904