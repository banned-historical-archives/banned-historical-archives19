{"ocr_results":[{"text":"·李作鹏回憶绿·第五篇·回輝煌","box":[[17,38],[419,29],[420,50],[18,60]]},{"text":"（五十）四野大反攻","box":[[231,132],[419,132],[419,152],[231,152]]},{"text":"浩浩百万師，横千軍如卷席。","box":[[170,175],[507,172],[507,197],[170,200]]},{"text":"沈平津雨决，东北华北全無。","box":[[172,208],[507,205],[507,225],[172,228]]},{"text":"跨江越嶺向南飛，中南六省飘红旗。","box":[[171,238],[506,235],[506,256],[171,259]]},{"text":"千帆查發渡海，天涯海角度腾利。","box":[[173,268],[506,266],[506,287],[173,289]]},{"text":"（五十一）離海南返廣州","box":[[212,360],[441,360],[441,380],[212,380]]},{"text":"天涯及海角，風景獨好。","box":[[198,403],[421,403],[421,423],[198,423]]},{"text":"全岛解放火消。","box":[[198,433],[359,433],[359,454],[198,454]]},{"text":"發展生產求富，陽光大道。","box":[[200,464],[464,464],[464,484],[200,484]]},{"text":"醉别海南岛，奉命北调。","box":[[201,496],[421,496],[421,513],[201,513]]},{"text":"新職重任恐挑。","box":[[201,524],[359,524],[359,544],[201,544]]},{"text":"聞息方抗强暴，心飛援朝。","box":[[202,554],[466,554],[466,575],[202,575]]},{"text":"方块字读书社区","box":[[270,904],[414,904],[414,925],[270,925]]},{"text":"386","box":[[64,964],[98,964],[98,983],[64,983]]}],"dimensions":{"height":1000,"width":684}}