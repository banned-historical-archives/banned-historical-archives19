{"ocr_results":[{"text":"作者簡介","box":[[385,145],[527,150],[526,181],[384,176]]},{"text":"李作鹏漢族，1914年4月生于江西","box":[[352,219],[592,225],[591,246],[351,240]]},{"text":"省吉安縣。","box":[[318,249],[392,249],[392,270],[318,270]]},{"text":"1930年参加中圆工晨红車，1931年","box":[[353,277],[594,280],[593,300],[353,297]]},{"text":"加入共產主義青年园，1932年轉入中国","box":[[319,305],[592,309],[592,330],[319,327]]},{"text":"共產重。1955年被授子中将軍街。","box":[[318,334],[554,336],[554,357],[318,355]]},{"text":"红軍時期，歷任红一方面軍總司今","box":[[354,363],[599,365],[598,385],[354,383]]},{"text":"部傳令兵，朱德警術排衡士、軍委谍報","box":[[320,392],[596,392],[596,412],[320,412]]},{"text":"科科員、单委機要科科员。参加了二篇","box":[[322,422],[596,422],[596,440],[322,440]]},{"text":"五千里長征，時任中革軍委二局二科科","box":[[321,450],[597,448],[598,468],[321,470]]},{"text":"长。","box":[[321,479],[348,479],[348,499],[321,499]]},{"text":"抗日争時期，是任八路車第115师","box":[[355,506],[598,504],[599,525],[355,527]]},{"text":"值察科长、作科长和参谋處處长。","box":[[322,536],[563,533],[563,553],[322,557]]},{"text":"解放我争時期，任東北民主那军","box":[[357,565],[599,559],[600,581],[358,586]]},{"text":"前方總部参谋處长，第一副司令员","box":[[323,593],[598,588],[599,609],[323,614]]},{"text":"兼参谋長，第六微限副司今員兼第16师","box":[[321,623],[599,616],[600,636],[322,643]]},{"text":"師长，第四野軍第43軍重长。","box":[[321,651],[543,646],[544,666],[322,672]]},{"text":"建图之后，任第15兵图参媒长，","box":[[358,680],[590,671],[591,692],[359,701]]},{"text":"第一高级步兵学校校长，總参谋部軍事训","box":[[322,709],[601,699],[602,721],[323,730]]},{"text":"部部长，海軍常務副司今员，副總参谋","box":[[320,738],[602,728],[603,748],[321,758]]},{"text":"长兼海軍第一政委。","box":[[321,766],[455,761],[456,782],[322,788]]},{"text":"1969年，在中共的第九届代表大","box":[[356,794],[599,783],[600,804],[357,815]]},{"text":"會上，當遥为中央委员、中央政治局委","box":[[324,824],[599,810],[600,831],[325,845]]},{"text":"員。同時当遥病中央軍委委員，并被任","box":[[324,851],[600,838],[601,860],[325,872]]},{"text":"命軍委娜事组成员。","box":[[321,879],[480,872],[481,893],[322,901]]},{"text":"方块字读书社区月因病去世，终年95裁。","box":[[267,902],[577,893],[577,920],[268,930]]}],"dimensions":{"height":1000,"width":684}}