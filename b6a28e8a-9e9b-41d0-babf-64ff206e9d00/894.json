{"ocr_results":[{"text":"·李作鹏回憶绿·第八篇·中人的心聲·","box":[[16,21],[493,11],[494,34],[17,45]]},{"text":"三十四、律師","box":[[252,128],[405,125],[405,147],[253,150]]},{"text":"1980年12月于北京復興醫院","box":[[196,175],[465,169],[465,190],[197,196]]},{"text":"尊敬公正人，天知無偏心。","box":[[200,218],[450,214],[450,235],[201,239]]},{"text":"官方護，和尚照念經。","box":[[201,249],[465,245],[465,266],[202,270]]},{"text":"遵命防風险，明哲可保身。","box":[[201,279],[450,276],[450,297],[202,300]]},{"text":"鼓敲雨下，有聲勝無聲。","box":[[202,311],[451,307],[451,328],[203,331]]},{"text":"三十五、寄語難友","box":[[242,395],[425,392],[426,416],[243,419]]},{"text":"1980年冬","box":[[288,439],[379,439],[379,460],[288,460]]},{"text":"我销陰房君开牢，患離相共，風雨霖雪煞。","box":[[168,484],[564,481],[564,501],[168,504]]},{"text":"不惜断頭血污草，何愁鐵窗和錄鳄。","box":[[170,512],[499,512],[499,532],[170,532]]},{"text":"將鹿馬强颠倒，五洲四海，鹦學舌少。","box":[[170,542],[564,541],[564,562],[170,564]]},{"text":"正氣歌聲风節高，粉身碎骨羞跪睛。","box":[[173,574],[501,574],[501,594],[173,594]]},{"text":"三十六、险渡一九八零年","box":[[226,659],[457,661],[457,683],[226,680]]},{"text":"1981年元旦信筆","box":[[266,702],[419,704],[419,724],[266,722]]},{"text":"去垂危年，鸣呼哀哉。","box":[[220,742],[460,745],[460,766],[220,763]]},{"text":"病魔狼毒心，瘟神。","box":[[220,771],[461,774],[461,794],[220,791]]},{"text":"幸喜妙手醫，堪慰苦舌载。","box":[[222,799],[461,803],[461,823],[222,819]]},{"text":"除蓓依稀梦，迎新鞭炮烟。","box":[[223,826],[462,831],[462,851],[223,847]]},{"text":"11.律师的种委官方方块字读书社区","box":[[73,892],[433,902],[432,930],[72,919]]},{"text":"注2.公容期間：托子女抄送食。","box":[[79,918],[301,925],[301,942],[78,935]]},{"text":"820","box":[[78,951],[114,951],[114,970],[78,970]]}],"dimensions":{"height":1000,"width":684}}