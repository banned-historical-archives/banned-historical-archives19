{"ocr_results":[{"text":"·李作鹏回憶绿·第五篇·回颜辉煌","box":[[11,29],[415,21],[415,42],[11,51]]},{"text":"（二十五）轉濱海","box":[[221,121],[422,117],[423,140],[221,144]]},{"text":"1941年春","box":[[272,164],[364,164],[364,185],[272,185]]},{"text":"抗倭相持戳，軍民渡難開。","box":[[173,210],[419,206],[419,227],[173,231]]},{"text":"誓束撃西似閃電，破","box":[[173,240],[462,237],[462,258],[173,261]]},{"text":"西有沂沐河，東濒黄海岸。","box":[[173,270],[422,268],[422,289],[173,291]]},{"text":"轉旗是處統全，力争乾坤轉。","box":[[174,301],[464,298],[464,318],[174,322]]},{"text":"（二十六）反","box":[[232,391],[411,391],[411,412],[232,412]]},{"text":"沂蒙粉碎人大棉荡","box":[[222,435],[415,435],[415,456],[222,456]]},{"text":"碧天黄地秋收忙，軍民套起反荡。","box":[[154,480],[486,479],[487,499],[154,500]]},{"text":"披星跳出合圍圈，乘霖切断交通網。","box":[[155,512],[487,512],[487,529],[155,529]]},{"text":"群深仇反清剿，民兵英勇破三光。","box":[[156,542],[486,542],[486,559],[156,559]]},{"text":"射虎蛟瘟神，人民争放光芒。","box":[[155,571],[488,572],[488,592],[155,591]]},{"text":"（二十七）海讨顽役","box":[[201,659],[450,661],[450,683],[200,680]]},{"text":"黄海腾浪，沐河揚沙，北山礼水南。","box":[[135,703],[488,705],[487,726],[135,724]]},{"text":"命令起兵，興師，星夜分路發。","box":[[135,732],[489,734],[488,755],[135,753]]},{"text":"激甲子山，直日莒郊，止兵勒馬。","box":[[134,760],[490,762],[489,786],[134,784]]},{"text":"缴獲數千，解放區域，又摘大。","box":[[136,791],[425,792],[425,814],[136,812]]},{"text":"诸日名山琅琊，有勾践觀海，赢政刻石","box":[[137,819],[511,820],[511,844],[137,843]]},{"text":"退軍，依靠日，盤踞此區挣扎。","box":[[139,848],[491,850],[491,874],[138,872]]},{"text":"授民是内行，反共是專家，曲线自。","box":[[141,878],[490,879],[490,900],[140,899]]},{"text":"摩擦首節停止方快家读书社区","box":[[141,906],[413,904],[413,925],[142,927]]},{"text":"378","box":[[45,966],[83,969],[81,992],[43,989]]}],"dimensions":{"height":1000,"width":684}}