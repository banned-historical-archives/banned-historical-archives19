2,868],[692,886],[96,887]]},{"text":"的重要支柱。","box":[[97,902],[213,902],[213,919],[97,919]]},{"text":"第二，要运用新思路、适应新要求，在西部大开发中继续调","box":[[138,933],[694,933],[694,953],[138,953]]},{"text":"整改造三线企业。①按照社会主义市场经济发展的要求，不断深","box":[[96,965],[692,963],[692,983],[96,985]]},{"text":"①《西藏日报》2002年10月29日。","box":[[126,1032],[385,1032],[385,1049],[126,1049]]},{"text":"467","box":[[648,1072],[692,1072],[692,1090],[648,1090]]}],"dimensions":{"height":1184,"width":801}}