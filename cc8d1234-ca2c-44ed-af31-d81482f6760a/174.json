5],[603,525]]},{"text":"（46%)","box":[[646,501],[733,501],[733,526],[646,526]]},{"text":"37(2%）","box":[[798,501],[917,501],[917,526],[798,526]]},{"text":"合計","box":[[240,532],[296,532],[296,563],[240,563]]},{"text":"703","box":[[447,533],[493,536],[491,564],[445,561]]},{"text":"967","box":[[650,534],[696,534],[696,561],[650,561]]},{"text":"1,670","box":[[829,536],[900,536],[900,561],[829,561]]},{"text":"上表示，學生（尤其是大學生）在文革中最極。中學生和大學生参加群","box":[[213,601],[1098,601],[1098,625],[213,625]]},{"text":"組織的人數，分别占學生總體的65%和69%。僮次於學生的是工人和知青，占","box":[[162,631],[1102,633],[1102,656],[162,654]]},{"text":"總數54%的工人和知青参加了群組織。韩部、教師和科（以下簡“科","box":[[161,662],[1048,662],[1048,685],[161,685]]},{"text":"員”）等参加的人數要少一些，約占總數的一半。農村的群運動不如城市普","box":[[159,691],[1076,692],[1076,719],[159,718]]},{"text":"及，所以相對來農民参與的人數最少，参加組織的只有29%。軍人中也有一些","box":[[161,726],[1102,726],[1102,749],[161,749]]},{"text":"人参與了群運動。不同職業之間参與比例的差，在統計學上有著意義","box":[[161,756],[1049,757],[1049,780],[161,779]]},{"text":"（x2=95.9，L2=96.1，自由度=8，P<0.0001）。","box":[[171,787],[744,788],[744,812],[171,811]]},{"text":"上表為我們提供了受訪者在文革中参加群組織的一些信息，但是還不能直","box":[[213,819],[1097,819],[1097,843],[213,843]]},{"text":"接用來估算民参加群組織的比例。這是因為，女性参加調查的人數比例重","box":[[161,851],[1102,851],[1102,874],[161,874]]},{"text":"失調（僮占受訪者總數的27%）。根據1964年人口普查資料，中國當時的男女","box":[[161,882],[1089,883],[1089,906],[161,905]]},{"text":"比例是51.33%比48.67%，約為1.05：1。此外，總體上，受訪女性参加群","box":[[162,912],[1088,913],[1088,937],[162,936]]},{"text":"組織的極性不如受訪的男性（女性為51%，低於男性的60%）。因此上表中各","box":[[162,945],[1101,945],[1101,968],[162,968]]},{"text":"職業的比例被無形中抬高了，没有真實地反映文革的實際情况。同時全國的群","box":[[162,976],[1102,976],[1102,999],[162,999]]},{"text":"運動發展不平衡，城市與晨村之間存在巨大的差别。為了能更准確地估算民","box":[[162,1007],[1101,1007],[1101,1030],[162,1030]]},{"text":"在文革中参加群組織的比例，我們將受訪者分為兩組。第一組是來自省會城市","box":[[161,1036],[1101,1037],[1101,1061],[161,1060]]},{"text":"的受訪者。由於四川的重慶然是非省會城市，但在四川文革中占據極其重要的","box":[[162,1069],[1102,1069],[1102,1092],[162,1092]]},{"text":"地位，我们將該市也列入第一組。符合這一條件的受訪者共有921人。第二組包","box":[[162,1100],[1102,1100],[1102,1122],[162,1122]]},{"text":"括明確明具體地方但於非省會的受訪者，該組共有539人。那些没有注明具","box":[[161,1131],[1102,1131],[1102,1154],[161,1154]]},{"text":"體城市或地專的受訪者（210人）未列入分析。以下是省會城市舆非省會城市","box":[[162,1162],[1100,1162],[1100,1185],[162,1185]]},{"text":"参加比例的分布以及調整後的估算：","box":[[162,1193],[575,1193],[575,1216],[162,1216]]},{"text":"表16.8民参加群組織的估算","box":[[443,1254],[831,1254],[831,1277],[443,1277]]},{"text":"中學","box":[[261,1316],[318,1316],[318,1346],[261,1346]]},{"text":"大學","box":[[351,1318],[407,1318],[407,1345],[351,1345]]},{"text":"工人","box":[[434,1318],[491,1318],[491,1344],[434,1344]]},{"text":"職員","box":[[530,1317],[586,1317],[586,1344],[530,1344]]},{"text":"知青","box":[[628,1316],[687,1316],[687,1346],[628,1346]]},{"text":"農民","box":[[719,1316],[778,1316],[778,1346],[719,1346]]},{"text":"其他","box":[[809,1318],[866,1318],[866,1345],[809,1345]]},{"text":"人數","box":[[895,1327],[954,1330],[952,1364],[893,1361]]},{"text":"生","box":[[272,1346],[305,1346],[305,1376],[272,1376]]},{"text":"生","box":[[361,1346],[396,1346],[396,1375],[361,1375]]},{"text":"調整前","box":[[523,1383],[604,1383],[604,1411],[523,1411]]},{"text":"省會","box":[[166,1418],[225,1418],[225,1448],[166,1448]]},{"text":"66%","box":[[266,1420],[312,1420],[312,1447],[266,1447]]},{"text":"70%","box":[[357,1420],[402,1420],[402,1446],[357,1446]]},{"text":"55%","box":[[440,1419],[487,1419],[487,1446],[440,1446]]},{"text":"61%","box":[[535,1420],[582,1420],[582,1447],[535,1447]]},{"text":"一","box":[[646,1422],[667,1422],[667,1447],[646,1447]]},{"text":"一","box":[[739,1423],[756,1423],[756,1445],[739,1445]]},{"text":"50%","box":[[815,1419],[861,1419],[861,1446],[815,1446]]},{"text":"921","box":[[899,1419],[944,1419],[944,1447],[899,1447]]},{"text":"非省","box":[[167,1450],[225,1453],[223,1484],[166,1481]]},{"text":"63%","box":[[266,1455],[311,1455],[311,1481],[266,1481]]},{"text":"56%","box":[[357,1455],[402,1455],[402,1481],[357,1481]]},{"text":"61%","box":[[441,1455],[487,1455],[487,1481],[441,1481]]},{"text"