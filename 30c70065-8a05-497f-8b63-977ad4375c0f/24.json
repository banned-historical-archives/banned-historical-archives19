,1040],[548,1041],[548,1060],[142,1059]]},{"text":"要抱住剥削隋級的售思想、舊文化、風俗、售惯的","box":[[142,1076],[733,1078],[733,1099],[142,1097]]},{"text":"细夙不放，無理，毅！","box":[[97,1114],[322,1115],[322,1135],[97,1134]]},{"text":"「文革民間思想」研究筆記","box":[[93,1181],[297,1184],[296,1204],[93,1201]]},{"text":".683","box":[[665,1182],[728,1188],[726,1210],[663,1204]]}],"dimensions":{"height":1265,"width":825}}