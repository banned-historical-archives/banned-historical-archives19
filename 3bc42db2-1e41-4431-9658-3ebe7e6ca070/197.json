{"ocr_results":[{"text":"诗日：","box":[[229,146],[323,146],[323,186],[229,186]]},{"text":"断肠断肠复断肠,","box":[[233,203],[514,199],[514,236],[233,240]]},{"text":"相思相思倍相思；","box":[[232,258],[514,255],[514,293],[232,296]]},{"text":"君恩似海何以报，","box":[[234,316],[514,313],[514,348],[234,351]]},{"text":"此恨绵绵无绝期;","box":[[235,369],[515,371],[515,406],[235,404]]},{"text":"念君豆蔻年华日，","box":[[237,427],[515,427],[515,460],[237,460]]},{"text":"念君孤苦探监时；","box":[[238,482],[516,482],[516,513],[238,513]]},{"text":".思君共叙马列志，","box":[[224,536],[522,534],[522,568],[224,570]]},{"text":"思君同读毛公诗；","box":[[241,590],[515,590],[515,624],[241,624]]},{"text":"今君不幸离人世，","box":[[241,642],[520,644],[520,678],[241,676]]},{"text":"变身资产者","box":[[1118,639],[1160,639],[1156,838],[1114,838]]},{"text":"愚有疑难再问谁？！","box":[[244,699],[577,699],[577,730],[244,730]]},{"text":"又日：","box":[[242,752],[330,752],[330,785],[242,785]]},{"text":"伶仃孤苦一老叟，","box":[[240,803],[525,807],[525,841],[239,837]]},{"text":"诗笔难抒满腔愁；","box":[[241,856],[518,861],[518,895],[240,890]]},{"text":"常向西天悼落日，","box":[[243,910],[519,914],[519,948],[242,944]]},{"text":"冷对苍穹叹旧游。","box":[[243,964],[519,968],[519,1002],[242,997]]},{"text":"贤卿一去不复返，","box":[[228,1068],[517,1075],[517,1109],[227,1103]]},{"text":"嗟余子立渡春秋;","box":[[237,1122],[520,1130],[519,1164],[236,1156]]},{"text":"天哭地哭人亦哭，","box":[[243,1176],[519,1184],[518,1218],[242,1210]]},{"text":"：似君知己更何求？","box":[[221,1225],[533,1237],[532,1272],[219,1260]]},{"text":"她的百日祭为7月27日，我偕儿孙及众亲友一起，将","box":[[164,1315],[1073,1319],[1073,1386],[164,1383]]},{"text":"她的灵骨安放在玉皇陵陵寝。","box":[[109,1361],[595,1395],[591,1446],[105,1412]]},{"text":"我声泪俱下地宣读了对她最后的祝福与思念。","box":[[169,1421],[906,1429],[905,1494],[168,1486]]},{"text":"(-)","box":[[577,1498],[667,1494],[669,1531],[579,1535]]},{"text":"我是乔木君是藤，","box":[[474,1552],[748,1547],[749,1581],[475,1587]]},{"text":"藤缠乔木乔依藤；","box":[[467,1604],[748,1598],[749,1633],[468,1639]]},{"text":"· 183·","box":[[991,1664],[1085,1661],[1086,1693],[992,1695]]}],"dimensions":{"height":1754,"width":1241}}