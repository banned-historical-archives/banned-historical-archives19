{"ocr_results":[{"text":"附录","box":[[73,61],[131,61],[131,85],[73,85]]},{"text":"红旗怨","box":[[362,147],[432,147],[432,172],[362,172]]},{"text":"1968年8月于长沙","box":[[324,186],[491,188],[490,209],[324,206]]},{"text":"四水映红旗，波涛行更急。","box":[[272,224],[531,224],[531,244],[272,244]]},{"text":"洞庭同庆贺，余波亦未息。","box":[[270,261],[532,262],[532,283],[270,282]]},{"text":"注：从武汉到达湖南时，正值湖南各派大联合，形势相对稳定，但各政治派别","box":[[78,299],[782,299],[782,319],[78,319]]},{"text":"之间的明争暗斗仍在激烈地进行着。","box":[[80,338],[398,338],[398,355],[80,355]]},{"text":"访友","box":[[376,409],[440,409],[440,434],[376,434]]},{"text":"1969年2月于武汉华中工学院","box":[[272,446],[544,448],[544,472],[272,470]]},{"text":"朔风催门紧，万里飞雪急。","box":[[271,488],[529,488],[529,507],[271,507]]},{"text":"束衣访故友，惊醒窗前梅。","box":[[271,523],[529,523],[529,543],[271,543]]},{"text":"松梅本色","box":[[362,598],[453,598],[453,622],[362,622]]},{"text":"1970年8月于湖北咸宁马桥","box":[[282,636],[532,639],[532,658],[282,656]]},{"text":"雷劈青松松更翠，雪压冬梅梅更红。","box":[[226,674],[575,674],[575,694],[226,694]]},{"text":"松梅本色皆如此，堪笑檐下可怜虫。","box":[[228,714],[575,714],[575,731],[228,731]]},{"text":"注：1970年8月，同学们均离开了咸宁走上了工作岗位。而我仍在湖北咸宁马","box":[[78,749],[785,749],[785,769],[78,769]]},{"text":"桥的“院学习班”接受“审查”。夜深了，“你不签字就别想离开马桥”的呵","box":[[79,786],[783,786],[783,806],[79,806]]},{"text":"斥声仍不绝于耳。几个月来的车轮战使我身心倍受煎熬，故作此句以自勉。","box":[[80,825],[751,825],[751,842],[80,842]]},{"text":"寄影书","box":[[373,897],[443,897],[443,922],[373,922]]},{"text":"1971年10月于昆明长坡","box":[[299,937],[516,937],[516,958],[299,958]]},{"text":"孤雁落云岭，只身栖长坡。","box":[[269,972],[541,972],[541,995],[269,995]]},{"text":"举目无亲友，四顾少知音。","box":[[272,1013],[532,1013],[532,1033],[272,1033]]},{"text":"瑟瑟风作伴，浙浙雨有声。","box":[[272,1050],[532,1050],[532,1070],[272,1070]]},{"text":"仰首望长空，浮想联翻：","box":[[271,1086],[527,1086],[527,1106],[271,1106]]},{"text":"少年乘竹马，意气高山巅。","box":[[272,1123],[531,1124],[531,1145],[272,1144]]},{"text":"继而读功课，奋发冷江?边。","box":[[269,1161],[543,1159],[543,1183],[269,1185]]},{"text":"求学到武汉，击浪扬子江。","box":[[271,1199],[529,1199],[529,1218],[271,1218]]},{"text":"血立重誓，定为国争光。","box":[[271,1236],[531,1237],[531,1258],[271,1257]]},{"text":"626","box":[[76,1339],[116,1339],[116,1362],[76,1362]]}],"dimensions":{"height":1430,"width":975}}