{"ocr_results":[{"text":"附录","box":[[74,61],[133,61],[133,85],[74,85]]},{"text":"访母校——华中工学院","box":[[295,147],[522,147],[522,171],[295,171]]},{"text":"1975年6月于武汉华中工学院","box":[[271,184],[544,186],[544,210],[271,207]]},{"text":"人迁事过面目非，相见无言泪先垂。","box":[[226,222],[578,222],[578,245],[226,245]]},{"text":"峥嵘岁月成过去，是非功过诉与谁?","box":[[224,260],[580,260],[580,283],[224,283]]},{"text":"杂感","box":[[373,332],[439,332],[439,358],[373,358]]},{"text":"1980年10月于昆明长坡","box":[[298,370],[518,372],[518,396],[297,394]]},{"text":"风雨三十秋，沉渣浊江流。","box":[[272,412],[530,412],[530,432],[272,432]]},{"text":"我君一场梦，天翻地倾覆。","box":[[270,448],[530,448],[530,471],[270,471]]},{"text":"民意不可欺，人心岂能侮？","box":[[271,486],[534,486],[534,508],[271,508]]},{"text":"山洪到来时，枯朽自飘浮。","box":[[271,521],[531,521],[531,544],[271,544]]},{"text":"免职","box":[[379,595],[444,597],[443,623],[377,620]]},{"text":"1981年11月于昆明长坡","box":[[299,636],[517,637],[517,657],[299,656]]},{"text":"丢去芝麻官，卸却千斤担。","box":[[272,672],[530,672],[530,695],[272,695]]},{"text":"移居白云间，我今得休养。","box":[[272,712],[531,712],[531,732],[272,732]]},{"text":"莫怨天和地，中华已在变。","box":[[272,748],[531,748],[531,771],[272,771]]},{"text":"待到劈雳时，笑看铺天浪。","box":[[271,786],[532,786],[532,808],[271,808]]},{"text":"自勉","box":[[383,858],[448,858],[448,884],[383,884]]},{"text":"1981年12月于昆明长坡","box":[[297,896],[518,898],[518,922],[296,920]]},{"text":"中华振兴多坎坷，男儿有志贵在搏。","box":[[226,935],[577,935],[577,958],[226,958]]},{"text":"扪心无愧对天地，是非功过任评说。","box":[[225,974],[576,974],[576,994],[225,994]]},{"text":"潮流","box":[[375,1046],[439,1046],[439,1071],[375,1071]]},{"text":"1982年11月于昆明长坡","box":[[298,1083],[518,1085],[518,1109],[297,1107]]},{"text":"位者被栓，","box":[[339,1122],[463,1122],[463,1146],[339,1146]]},{"text":"奄奄者举鞭，","box":[[338,1159],[459,1159],[459,1183],[338,1183]]},{"text":"弥留者发出无声的命令。","box":[[283,1199],[520,1199],[520,1219],[283,1219]]},{"text":"空气早已凝结，","box":[[329,1235],[474,1235],[474,1259],[329,1259]]},{"text":"628","box":[[76,1338],[116,1338],[116,1361],[76,1361]]}],"dimensions":{"height":1430,"width":975}}