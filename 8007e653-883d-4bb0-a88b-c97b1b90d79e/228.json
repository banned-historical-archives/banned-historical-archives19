{"ocr_results":[{"text":"文革篇","box":[[74,61],[139,61],[139,85],[74,85]]},{"text":"艰难险阻何所惧，","box":[[124,146],[295,148],[294,172],[124,170]]},{"text":"万水千山只等闲。","box":[[126,187],[295,187],[295,208],[126,208]]},{"text":"解放全人类，","box":[[124,220],[250,223],[250,247],[124,245]]},{"text":"永远忠于党。","box":[[124,258],[249,260],[249,285],[124,283]]},{"text":"亲爱的战友们，","box":[[126,335],[271,335],[271,358],[126,358]]},{"text":"此时此刻，","box":[[125,372],[229,372],[229,397],[125,397]]},{"text":"你有何感想？","box":[[125,409],[250,409],[250,433],[125,433]]},{"text":"你有何打算?","box":[[125,447],[251,447],[251,471],[125,471]]},{"text":"是捍卫毛主席的革命路线，","box":[[126,523],[386,523],[386,546],[126,546]]},{"text":"还是放任资本主义复辟？","box":[[127,561],[363,561],[363,582],[127,582]]},{"text":"是前进还是后退？","box":[[126,599],[296,599],[296,620],[126,620]]},{"text":"是奋发还是消极?","box":[[124,633],[297,636],[296,659],[124,657]]},{"text":"是做奴隶还是要做主人？","box":[[126,674],[364,674],[364,694],[126,694]]},{"text":"事实是如此严峻，","box":[[125,708],[297,710],[296,734],[125,732]]},{"text":"历史是如此无情，","box":[[126,749],[295,749],[295,770],[126,770]]},{"text":"在此关键的时刻，","box":[[124,783],[296,786],[295,809],[124,807]]},{"text":"你千万不要迟疑！","box":[[126,824],[294,824],[294,845],[126,845]]},{"text":"亲爱的战友们，","box":[[126,896],[272,898],[272,922],[126,919]]},{"text":"请戴上你那金光闪耀的主席像章，","box":[[126,935],[455,935],[455,958],[126,958]]},{"text":"庄严地戴上那象征无畏的红卫兵袖章，","box":[[125,973],[500,974],[500,995],[125,994]]},{"text":"赶快振作起来，","box":[[124,1010],[273,1010],[273,1034],[124,1034]]},{"text":"战斗起来！","box":[[125,1048],[229,1048],[229,1072],[125,1072]]},{"text":"是雄鹰，快展翅长空，","box":[[126,1123],[340,1123],[340,1144],[126,1144]]},{"text":"是海燕，快飞向海洋，","box":[[127,1162],[341,1162],[341,1183],[127,1183]]},{"text":"一场暴风雨就要来临了，","box":[[127,1200],[362,1200],[362,1220],[127,1220]]},{"text":"一场严峻的考验就要开始了。","box":[[127,1235],[408,1236],[408,1257],[127,1256]]},{"text":"214","box":[[76,1338],[117,1338],[117,1361],[76,1361]]}],"dimensions":{"height":1430,"width":975}}