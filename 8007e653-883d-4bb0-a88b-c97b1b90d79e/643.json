{"ocr_results":[{"text":"拾贝集","box":[[833,59],[899,59],[899,84],[833,84]]},{"text":"大地死一般沉寂。","box":[[416,147],[587,147],[587,171],[416,171]]},{"text":"太阳升起来，又落下了，","box":[[385,187],[619,187],[619,208],[385,208]]},{"text":"山河如故：月圆月缺。","box":[[397,223],[608,223],[608,244],[397,244]]},{"text":"啊，别忘了：","box":[[438,258],[564,260],[563,285],[438,283]]},{"text":"历史车轮谁能阻挡？","box":[[407,299],[600,299],[600,320],[407,320]]},{"text":"蓄之愈久，","box":[[450,334],[552,331],[553,359],[450,362]]},{"text":"爆发愈烈！","box":[[450,371],[555,371],[555,396],[450,396]]},{"text":"迎春","box":[[479,446],[545,446],[545,472],[479,472]]},{"text":"1983年12月于昆明长坡","box":[[397,484],[619,486],[618,510],[397,507]]},{"text":"枯树绽新蕾，残雪锁旧枝。","box":[[372,522],[631,522],[631,545],[372,545]]},{"text":"花开映日月，严冰能几时？","box":[[377,561],[639,561],[639,581],[377,581]]},{"text":"小桥和白云","box":[[449,630],[566,633],[565,661],[449,658]]},{"text":"1992年7月于昆明","box":[[424,672],[592,674],[592,695],[423,693]]},{"text":"小桥伴流水，白云恋青山。","box":[[374,712],[631,712],[631,732],[374,732]]},{"text":"相依坦荡荡，自然即是缘。","box":[[372,748],[629,748],[629,768],[372,768]]},{"text":"咏莲","box":[[475,821],[540,821],[540,847],[475,847]]},{"text":"2011年8月于昆明","box":[[423,859],[593,861],[593,885],[422,883]]},{"text":"芙蓉如约至，凌波入梦来。","box":[[372,898],[631,898],[631,921],[372,921]]},{"text":"守得来时身，平步上瑶台。","box":[[373,935],[633,935],[633,958],[373,958]]},{"text":"逍遥游","box":[[472,1009],[543,1009],[543,1034],[472,1034]]},{"text":"2011年11月于昆明","box":[[419,1048],[596,1048],[596,1069],[419,1069]]},{"text":"我梦上蓝天，游戏白云间。","box":[[371,1084],[630,1084],[630,1107],[371,1107]]},{"text":"了却凡尘事，佳人伴神仙。","box":[[373,1122],[629,1122],[629,1145],[373,1145]]},{"text":"629","box":[[860,1337],[898,1337],[898,1361],[860,1361]]}],"dimensions":{"height":1430,"width":975}}