654],[703,654]]},{"text":"-500.00","box":[[196,658],[238,658],[238,673],[196,673]]},{"text":"1955","box":[[280,673],[310,673],[310,689],[280,689]]},{"text":"1956","box":[[379,673],[410,673],[410,689],[379,689]]},{"text":"1957","box":[[480,673],[509,673],[509,689],[480,689]]},{"text":"1958","box":[[579,673],[610,673],[610,689],[579,689]]},{"text":"1959","box":[[680,673],[710,673],[710,689],[680,689]]},{"text":"1960","box":[[778,672],[811,672],[811,691],[778,691]]},{"text":"知乎@三哥","box":[[871,675],[1031,675],[1031,703],[871,703]]},{"text":"■出口进口进出口差","box":[[550,699],[689,699],[689,716],[550,716]]},{"text":"数据来源：","box":[[419,751],[558,751],[558,772],[419,772]]},{"text":"《中国统计年鉴1982》，p368","box":[[547,751],[872,752],[872,773],[547,772]]},{"text":"上图可以看出，在大跃进的三年期间，我国一直在大量出口粮食。进口粮","box":[[244,794],[1036,794],[1036,817],[244,817]]},{"text":"食数量几乎减少到忽略不计。三年累计净出口粮食947亿斤。这个数字比","box":[[190,826],[985,826],[985,849],[190,849]]},{"text":"1959-1960年粮食年度内，国家向农村提供的“返销粮”还要多59亿斤！","box":[[189,858],[980,858],[980,880],[189,880]]},{"text":"中国在三年困难时期，也没有停止对第三世界国家的援助。","box":[[241,901],[873,901],[873,924],[241,924]]},{"text":"阿尔巴里亚领导人霍查的女婿、阿外交官马利列，在他的文章《我眼中的","box":[[240,946],[1035,946],[1035,966],[240,966]]},{"text":"中国政要》里回忆说：1962年，他到中国要求粮食援助，找到外贸部部长李","box":[[189,975],[1016,976],[1016,999],[189,998]]},{"text":"强，无果：后来还是找到刘少奇解决了问题。恰巧当时，缺粮食的中国向加拿","box":[[190,1010],[1034,1010],[1034,1030],[190,1030]]},{"text":"大进口了大批小麦，几艘载满小麦的中国轮船正在大西洋驶往中国，接到中央","box":[[190,1041],[1034,1041],[1034,1061],[190,1061]]},{"text":"的命令后，立即改变航向，调头驶向阿国的港口卸下了全部小麦。","box":[[189,1075],[897,1076],[897,1097],[189,1096]]},{"text":"3、苏联逼债的真相","box":[[256,1148],[534,1148],[534,1175],[256,1175]]},{"text":"上世纪60年代初中苏关系恶化和出现饥荒后，国内曾以干部宣讲和群众口","box":[[241,1225],[1047,1226],[1047,1248],[241,1247]]},{"text":"传方式出现了“中国为抗美援朝欠债，苏修逼债造成挨饿”之说，并在多年间","box":[[190,1257],[1035,1257],[1035,1280],[190,1280]]},{"text":"被一些文艺作品和非当事者的文章引用，致使许多人长期信以为真。[131]","box":[[190,1292],[997,1292],[997,1312],[190,1312]]},{"text":"在课堂上、田地间和车间里，中国老百姓绘声绘色的描述中苏边境铁路交","box":[[241,1335],[1035,1335],[1035,1355],[241,1355]]},{"text":"接所在进行货物交接时，苏联人的刁难，例如当时鸡蛋都是用一个铁丝圈圈过","box":[[190,1367],[1035,1367],[1035,1387],[190,1387]]},{"text":"的，大了小了都不行，稻谷一定要放在扬谷机吹到完全吹不出谷，苹果要测","box":[[189,1399],[1036,1399],[1036,1422],[189,1422]]},{"text":"量个头大小，猪肉必须达到四指，甚至有流传苏联人爱吃猪尾巴，中方只好","box":[[190,1431],[1036,1431],[1036,1454],[190,1454]]},{"text":"在边境割了猪尾巴运过去。[132]","box":[[190,1464],[546,1464],[546,1487],[190,1487]]},{"text":"1961年2月，赫鲁晓夫致函毛泽东，提出苏联可立即借给中国100万吨粮","box":[[239,1506],[1041,1507],[1041,1530],[239,1529]]},{"text":"食和50万吨古巴糖。一周后，周恩来总理代表中共中央口头答复，感谢苏联","box":[[190,1538],[1023,1539],[1023,1562],[190,1561]]},{"text":"《》人民的好意，但是不必了，苏联可将这些粮食作为后备措施，实际上就是","box":[[201,1574],[1034,1574],[1034,1593],[201,1593]]}],"dimensions":{"height":1755,"width":1242}}