,[773,1409],[773,1424],[743,1424]]},{"text":"1963","box":[[829,1408],[860,1408],[860,1424],[829,1424]]},{"text":"粗钢（万吨）","box":[[454,1439],[552,1439],[552,1453],[454,1453]]},{"text":"生铁（万吨）一粗钢增速（%）一生铁增速（%）","box":[[544,1437],[895,1436],[895,1453],[544,1454]]},{"text":"大跃进前后时期钢铁产量变化趋势","box":[[240,1490],[609,1491],[609,1514],[240,1513]]},{"text":"但是产量的大跃进和高速度的增长，并不能掩盖产品质量的下降、安全事","box":[[241,1536],[1035,1536],[1035,1556],[241,1556]]},{"text":"故的增多和劳动时间的延长。","box":[[191,1568],[496,1568],[496,1587],[191,1587]]}],"dimensions":{"height":1755,"width":1242}}