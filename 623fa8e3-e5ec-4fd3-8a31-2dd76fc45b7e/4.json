{"ocr_results":[{"text":"我决不申诉","box":[[262,401],[393,401],[393,429],[262,429]]},{"text":"我个人的遭遇。","box":[[262,446],[433,442],[434,470],[262,473]]},{"text":"错过的青春，","box":[[264,489],[409,489],[409,517],[264,517]]},{"text":"变形的灵魂，","box":[[265,534],[410,532],[410,560],[265,562]]},{"text":"无数失眠之夜","box":[[267,580],[422,577],[422,602],[267,605]]},{"text":"留下来痛苦的回忆。","box":[[268,623],[488,619],[488,646],[268,650]]},{"text":"我推翻了一道道定义；","box":[[266,667],[516,664],[517,691],[266,694]]},{"text":"我打碎了一层层伽锁；","box":[[269,713],[515,710],[516,734],[269,737]]},{"text":"心中只剩下","box":[[268,752],[398,752],[398,780],[268,780]]},{"text":"一片触目的废墟….·","box":[[268,798],[500,792],[501,823],[269,829]]},{"text":"但是，我站起来了，","box":[[269,843],[480,840],[480,868],[269,871]]},{"text":"站在广阔的地平线上，","box":[[272,888],[517,884],[518,911],[272,915]]},{"text":"再没有人，没有任何手段","box":[[272,933],[547,927],[547,954],[272,960]]},{"text":"能把我重新推下去。","box":[[273,977],[495,973],[495,1000],[273,1004]]},{"text":"舒婷《一代人的呼声》（1980）","box":[[274,1066],[587,1060],[588,1087],[274,1093]]}],"dimensions":{"height":1378,"width":812}}